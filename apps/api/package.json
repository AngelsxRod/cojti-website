{
  "name": "cojti-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && concurrently -k \"swc src -d dist --strip-leading-paths --watch\" \"node --watch dist/main.js\"",
    "build": "swc src -d dist --strip-leading-paths",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "start": "node dist/main",
    "start:debug": "node --inspect --watch dist/main.js",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\""
  },
  "dependencies": {
    "@cojti/api": "workspace:*",
    "@cojti/db": "workspace:*",
    "@nestjs/common": "12.0.2",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "drizzle-orm": "0.45.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@cojti/eslint-config": "workspace:*",
    "@cojti/jest-config": "workspace:*",
    "@cojti/typescript-config": "workspace:*",
    "@jest/globals": "30.5.1",
    "@nestjs/cli": "12.0.1",
    "@nestjs/schematics": "12.0.2",
    "@nestjs/testing": "12.0.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "jest": "30.5.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "7.0.2"
  }
}
