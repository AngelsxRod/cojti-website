{
  "name": "cojti",
  "version": "0.0.0",
  "private": true,
  "description": "Sitio web de Demetrio Cojtí Cuxil",
  "author": "Demetrio Cojtí Cuxil",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "test": "node --test scripts/*.test.mjs && turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "lint:commits": "commitlint",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@cojti/eslint-config": "workspace:*",
    "@cojti/typescript-config": "workspace:*",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "pnpm": "12.4.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.8"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.11.0"
  }
}
