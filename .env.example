# Use a long URL-safe password (letters, digits, hyphens or underscores).
COJTI_DB_PASSWORD=replace-with-a-long-random-password
# Optional local host port for MariaDB (defaults to 3306).
COJTI_MARIADB_PORT=3306
LINKS_WRITE_API_KEY=replace-with-a-long-random-api-key
BETTER_AUTH_SECRET=replace-with-a-long-random-auth-secret
BETTER_AUTH_URL=http://localhost:3001
