{
  "name": "@cojti/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "auth:generate": "auth generate --config ./auth.ts --output ../db/src/auth-schema.ts --adapter drizzle --dialect mysql --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@cojti/db": "workspace:*",
    "better-auth": "^1.7.10",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@cojti/eslint-config": "workspace:*",
    "@cojti/typescript-config": "workspace:*",
    "@types/node": "26.6.5",
    "auth": "^1.7.10",
    "eslint": "10.10.0",
    "typescript": "7.0.2"
  }
}
